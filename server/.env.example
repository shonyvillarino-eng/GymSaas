# Supabase (real values go in .env, never in the repo)
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=paste_the_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=paste_the_secret_key_here
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Runtime
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
READY_TIMEOUT_MS=5000
JWT_SECRET=paste_a_real_secret_here
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=gym_saas_jwt
JWT_COOKIE_SECURE=true

# S3 (optional, leave empty if not using object storage)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
