# ─── Supabase host ────────────────────────────────────────────────────────────
# Copied from the Supabase Dashboard → Project settings → API.
# Cells below are placeholders; replace them before deploy.
SUPABASE_URL=https://urigjwyugpffaexqxugc.supabase.co
SUPABASE_ANON_KEY=paste_the_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=paste_the_secret_key_here
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Backend server ──────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Auth: Supabase issuer + JWT verification ───────────────────────────────
SUPABASE_AUTH_URL=https://urigjwyugpffaexqxugc.supabase.co
SUPABASE_AUTH_ISSUER=https://urigjwyugpffaexqxugc.supabase.co
SUPABASE_AUTH_JWKS_URL=https://urigjwyugpffaexqxugc.supabase.co/auth/v1/jwks
JWT_SESSION_KEY=paste_a_strong_session_secret_here

# ─── Email (optional; notifications log instead when absent) ────────────────
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_FROM=noreply@example.com
