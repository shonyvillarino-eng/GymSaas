# Environment
NODE_ENV=production
PORT=4000

# Database
DATABASE_URL=postgresql://user:password@host:5432/gym_saas?sslmode=require

# CORS
CORS_ORIGIN=https://app.tudominio.com

# JWT Auth
JWT_SECRET=change-me-to-a-very-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
JWT_COOKIE_NAME=gym_saas_token
JWT_COOKIE_SECURE=true

# Object Storage (S3 compatible) - optional but recommended for production
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
