// ============================================================================
// GymFlow · Multi-Tenant Gym Management SaaS — Prisma Schema
// ============================================================================
//
// Conventions:
//   - Every tenant-scoped model carries a non-nullable `gymId`.
//   - Monetary values are `Decimal` (never Float).
//   - Soft deletes use `deletedAt`; financial/attendance history is never hard-deleted.
//   - Enums are shared across models for consistent state modelling.
//   - Referential actions protect historical records (PaymentRecord, Attendance).
//
// Multi-tenant security (ENFORCED AT QUERY TIME, not trust in client gymId):
//   Every read/write MUST scope by gymId derived from the authenticated session
//   (JWT payload), never from request body/query. The schema provides the
//   `gymId` FK columns and composite unique indexes so scoped queries are
//   efficient and unscoped writes are caught in review.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  GYM_ADMIN
  INSTRUCTOR
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  FROZEN
  PENDING
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
  FROZEN
}

enum MembershipDurationUnit {
  DAY
  WEEK
  MONTH
  QUARTER
  HALF_YEAR
  YEAR
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
  // Administrative annulment: the movement is kept for the audit trail but no
  // longer counts towards collected amounts or obligation balances.
  VOIDED
}

// Financial state of a receivable. Derived from the balance and the due date —
// deliberately independent from SubscriptionStatus and MemberStatus.
enum ObligationStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  BANK_TRANSFER
  CHECK
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  CANCELLED
  EXCUSED
}

/// How the entry was captured at the front desk.
enum AttendanceMethod {
  MANUAL
  QR
}

/// Whether the entry satisfied the gym access policy or was authorized as an
/// explicit administrative exception (always justified and audited).
enum AttendanceResult {
  ALLOWED
  EXCEPTION
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  EXTREME
}

/// Lifecycle of a training routine.
enum RoutineStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  CORE
  GLUTES
  FULL_BODY
  CARDIO
  OTHER
}

enum ExerciseType {
  STRENGTH
  CARDIO
  FLEXIBILITY
  BALANCE
  PLYOMETRICS
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// Administrative state of a member — intentionally separate from the state
// of their memberships (a member can be ACTIVE with an expired membership).
enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InstructorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Document identity: uniqueness is enforced per gym on (type, number).
enum DocumentType {
  DNI
  CUIL
  CUIT
  PASSPORT
  NATIONAL_ID
  DRIVER_LICENSE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  ASSIGN
  UNASSIGN
  PAYMENT_REGISTERED
  ATTENDANCE_MARKED
  ROUTINE_ASSIGNED
}

enum AuthTokenType {
  SETUP
  RESET
  INSTRUCTOR_INVITE
  /// Grants the member portal to an existing member account (one-time link).
  MEMBER_INVITE
}

enum ProgressMetric {
  WEIGHT
  BODY_FAT
  MUSCLE_MASS
  CHEST
  WAIST
  HIPS
  BICEPS
  THIGH
  HEIGHT
  BMI
  OTHER
}

enum NotificationType {
  MEMBERSHIP_EXPIRING
  MEMBERSHIP_EXPIRED
  MEMBERSHIP_RENEWED
  MEMBERSHIP_STATUS
  ROUTINE_ASSIGNED
  ROUTINE_UPDATED
  ROUTINE_REPLACED
  PAYMENT_REGISTERED
  PAYMENT_VOIDED
  PAYMENT_PENDING
  ANNOUNCEMENT
  GENERAL
  INSTRUCTOR_NOTICE
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL
  MEMBERS
  INSTRUCTORS
  SPECIFIC_MEMBER
  SPECIFIC_INSTRUCTOR
}

// ── Core: Gym ────────────────────────────────────────────────────────────────

model Gym {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(120)
  slug       String   @unique @db.VarChar(80)
  legalName  String?  @db.VarChar(160)
  taxId      String?  @db.VarChar(40)
  email      String?  @db.VarChar(160)
  phone      String?  @db.VarChar(40)
  address         String?  @db.VarChar(240)
  city            String?  @db.VarChar(80)
  province        String?  @db.VarChar(80)
  postalCode      String?  @db.VarChar(24)
  country         String?  @db.VarChar(80)
  website         String?  @db.VarChar(255)
  description     String?
  timezone        String   @default("UTC") @db.VarChar(64)
  currency        String   @default("USD") @db.VarChar(3)
  language        String?  @db.VarChar(10)
  locale          String?  @db.VarChar(20)
  logoUrl         String?
  isActive        Boolean  @default(true)
  suspendedAt     DateTime?
  suspensionReason String?  @db.VarChar(500)
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  memberships        GymMembership[]
  memberProfiles     MemberProfile[]
  instructorProfiles InstructorProfile[]
  instructorMembers  InstructorMember[]
  plans              MembershipPlan[]
  subscriptions      MemberSubscription[]
  obligations        FinancialObligation[]
  payments           PaymentRecord[]
  receiptCounter     ReceiptCounter?
  cashRegisters      CashRegister[]
  attendances        Attendance[]
  routines           Routine[]
  routineDays        RoutineDay[]
  routineExercises   RoutineExercise[]
  routineVersions    RoutineVersion[]
  exercises          Exercise[]
  progressRecords    ProgressRecord[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  announcements      Announcement[]
  notificationPrefs  NotificationPreference[]
  notificationLogs   NotificationLog[]

  @@index([isActive])
  @@index([createdAt])
}

// ── Core: User (credentials) ─────────────────────────────────────────────────
// A User may exist without a GymMembership (e.g. SUPER_ADMIN platform-level).

model User {
  id            String    @id @default(uuid())
  email         String?   @unique @db.VarChar(160)
  passwordHash  String    @db.VarChar(255)
  fullName      String    @db.VarChar(120)
  phone         String?   @db.VarChar(40)
  avatarUrl     String?
  role          UserRole  @default(MEMBER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  language      String?   @db.VarChar(10)
  preferences   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  memberships            GymMembership[]
  memberProfile          MemberProfile?
  instructorProfile      InstructorProfile?
  registeredPayments     PaymentRecord[]      @relation("PaymentRegistrar")
  voidedPayments         PaymentRecord[]      @relation("PaymentVoider")
  recordedAttendances    Attendance[]           @relation("AttendanceRegistrar")
  auditLogs              AuditLog[]
  progressRecords        ProgressRecord[]
  createdRoutines        Routine[]             @relation("RoutineCreator")
  routineVersions       RoutineVersion[]     @relation("RoutineVersionAuthor")
  createdExercises       Exercise[]            @relation("ExerciseCreator")
  assignedSubscriptions  MemberSubscription[]  @relation("SubscriptionAssigner")
  authTokens             AuthToken[]
  openedCashRegisters    CashRegister[]        @relation("CashRegisterOpener")
  closedCashRegisters    CashRegister[]        @relation("CashRegisterCloser")
  notifications          Notification[]
  announcements          Announcement[]
  notificationPreference NotificationPreference?

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

// ── GymMembership: user ↔ gym with role ──────────────────────────────────────
// One row per (gymId, userId). The `role` here overrides the User's default
// `role` when the user belongs to multiple gyms.
// The unique constraint on [gymId, userId] + partial unique index (via raw SQL)
// enforces "exactly one active GYM_ADMIN per gym".

model GymMembership {
  id        String    @id @default(uuid())
  gymId     String
  userId    String
  role      UserRole  @default(MEMBER)
  isActive  Boolean   @default(true)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@index([gymId, role])
  @@index([gymId, isActive])
  @@index([userId])
}

// ── MemberProfile: per-gym member details ────────────────────────────────────

model MemberProfile {
  id            String       @id @default(uuid())
  gymId         String
  userId        String       @unique
  documentType  DocumentType?
  documentNumber String?     @db.VarChar(20)
  status        MemberStatus @default(ACTIVE)
  joinDate      DateTime     @default(now())
  address       String?      @db.VarChar(240)
  emergencyName String?      @db.VarChar(120)
  emergencyPhone String?     @db.VarChar(40)
  bloodType     String?      @db.VarChar(8)
  healthNotes   String?
  birthDate     DateTime?
  gender        Gender?
  heightCm      Decimal?     @db.Decimal(6, 2)
  weightKg      Decimal?     @db.Decimal(6, 2)
  goals         String[]
  fitnessLevel  FitnessLevel @default(BEGINNER)
  notes         String?
  /// Opaque check-in credential (random, revocable, never sequential).
  /// Holds no personal data: only this member's identity can be resolved from it.
  qrToken          String?      @unique @db.VarChar(64)
  qrTokenCreatedAt DateTime?
  qrRevokedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  gym                 Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructorMembers   InstructorMember[]
  subscriptions       MemberSubscription[]
  obligations         FinancialObligation[]
  payments            PaymentRecord[]
  attendances         Attendance[]
  progressRecords     ProgressRecord[]
  assignedRoutines    Routine[]

  @@unique([gymId, documentType, documentNumber])
  @@index([gymId])
  @@index([userId])
  @@index([gymId, status])
  @@index([gymId, joinDate])
}

// ── InstructorProfile: per-gym instructor details ────────────────────────────

model InstructorProfile {
  id              String           @id @default(uuid())
  gymId           String
  userId          String           @unique
  documentType    DocumentType?
  documentNumber  String?          @db.VarChar(30)
  birthDate       DateTime?
  address         String?          @db.VarChar(240)
  specialization  String[]         @default([])
  certifications  String[]         @default([])
  bio             String?
  notes           String?          @db.VarChar(1000)
  hourlyRate      Decimal?         @db.Decimal(8, 2)
  maxMembers      Int              @default(0)
  status          InstructorStatus @default(ACTIVE)
  isAvailable     Boolean          @default(true)
  startDate       DateTime         @default(now())
  endDate         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  gym     Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  members InstructorMember[]
  routines Routine[]        @relation("RoutineInstructor")

  @@index([gymId])
  @@index([gymId, isAvailable])
  @@index([userId])
}

// ── InstructorMember: assignment of members to instructors ───────────────────
// `isPrimary` distinguishes the main instructor from additional assignments.

model InstructorMember {
  id          String    @id @default(uuid())
  gymId       String
  instructorId String
  memberId    String
  isPrimary   Boolean   @default(false)
  assignedAt  DateTime  @default(now())
  assignedBy  String?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gym        Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  instructor InstructorProfile  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  member     MemberProfile      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Assignment history is append-only; partial indexes enforce one active
  // assignment per instructor/member pair and at most one active primary.
  @@index([gymId])
  @@index([instructorId, isActive])
  @@index([memberId, isActive])
}

// ── MembershipPlan: plans offered by a gym ───────────────────────────────────

model MembershipPlan {
  id            String        @id @default(uuid())
  gymId         String
  name          String        @db.VarChar(120)
  description   String?
  price         Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD") @db.VarChar(3)
  billingDays   Int           @default(30)
  durationValue Int           @default(1)
  durationUnit  MembershipDurationUnit @default(MONTH)
  conditions    String?
  maxMembers    Int           @default(0)
  features      String[]      @default([])
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  gym           Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions MemberSubscription[]

  @@unique([gymId, name])
  @@index([gymId, isActive])
  @@index([gymId])
}

// ── MemberSubscription: active subscription of a member to a plan ────────────

model MemberSubscription {
  id            String             @id @default(uuid())
  gymId         String
  memberId      String
  planId        String
  planNameAtPurchase String       @db.VarChar(120)
  currencyAtPurchase String      @default("USD") @db.VarChar(3)
  status        SubscriptionStatus @default(PENDING)
  startDate     DateTime
  endDate       DateTime
  autoRenew     Boolean            @default(false)
  priceAtPurchase Decimal           @db.Decimal(10, 2)
  discountAmount Decimal            @default(0) @db.Decimal(10, 2)
  finalPrice    Decimal              @default(0) @db.Decimal(10, 2)
  assignedById  String?
  notes         String?
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  gym    Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member MemberProfile  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("SubscriptionAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  payments PaymentRecord[]
  obligations FinancialObligation[]

  @@index([gymId, status])
  @@index([gymId, memberId])
  @@index([gymId, endDate])
  @@index([memberId])
  @@index([planId])
  // Global lifecycle sweeps (no gymId in the filter): the periodic timer looks
  // up subscriptions by status + endDate/startDate across every tenant.
  @@index([status, endDate])
  @@index([status, startDate])
}

// ── PaymentRecord: manual payment history (never hard-deleted) ───────────────

// ── FinancialObligation: an amount a member owes (a receivable) ──────────────
// Kept separate from MemberSubscription: a membership can be active while its
// fee is still owed, and an expired membership does not imply an overdue debt.
// `paidAmount`/`balance` are derived from non-voided PaymentRecord rows and are
// recalculated inside the same transaction that writes a movement.

model FinancialObligation {
  id               String           @id @default(uuid())
  gymId            String
  memberId         String
  subscriptionId   String?
  concept          String           @db.VarChar(200)
  originalAmount   Decimal          @db.Decimal(12, 2)
  paidAmount       Decimal          @default(0) @db.Decimal(12, 2)
  currency         String           @default("USD") @db.VarChar(3)
  issuedAt         DateTime         @default(now())
  dueDate          DateTime
  status           ObligationStatus @default(PENDING)
  cancelledAt      DateTime?
  cancellationReason String?        @db.VarChar(500)
  notes            String?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  gym          Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member       MemberProfile       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  subscription MemberSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments     PaymentRecord[]

  // One fee per (subscription, concept) keeps retries of the generator idempotent.
  @@unique([gymId, subscriptionId, concept])
  @@index([gymId, status])
  @@index([gymId, dueDate])
  @@index([gymId, memberId])
  @@index([subscriptionId])
}

// ── ReceiptCounter: atomic per-gym receipt numbering ─────────────────────────

model ReceiptCounter {
  gymId     String @id
  nextValue Int    @default(1)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

// ── CashRegister: administrative daily cash session ──────────────────────────
// Totals are administrative records, not verified physical cash. `countedAmount`
// is what an operator declares; `expectedAmount`/`difference` are computations.

model CashRegister {
  id             String             @id @default(uuid())
  gymId          String
  status         CashRegisterStatus @default(OPEN)
  currency       String             @default("USD") @db.VarChar(3)
  openedAt       DateTime           @default(now())
  openedById     String
  openingBalance Decimal            @default(0) @db.Decimal(12, 2)
  closedAt       DateTime?
  closedById     String?
  expectedAmount Decimal?           @db.Decimal(12, 2)
  countedAmount  Decimal?           @db.Decimal(12, 2)
  difference     Decimal?           @db.Decimal(12, 2)
  notes          String?            @db.VarChar(1000)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  gym      Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  openedBy User          @relation("CashRegisterOpener", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy User?         @relation("CashRegisterCloser", fields: [closedById], references: [id], onDelete: SetNull)
  payments PaymentRecord[]

  @@index([gymId, status])
  @@index([gymId, openedAt])
}

// ── PaymentRecord: manual payment history (never hard-deleted) ───────────────

model PaymentRecord {
  id            String        @id @default(uuid())
  gymId         String
  memberId      String?
  subscriptionId String?
  obligationId  String?
  cashRegisterId String?
  receiptNumber String        @db.VarChar(40)
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD") @db.VarChar(3)
  concept       String        @db.VarChar(200)
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(COMPLETED)
  paidAt        DateTime      @default(now())
  reference     String?       @db.VarChar(120)
  notes         String?
  recordedById  String?
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?       @db.VarChar(500)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  gym          Gym                 @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member       MemberProfile?      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  subscription MemberSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  obligation   FinancialObligation? @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  cashRegister CashRegister?       @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  recordedBy   User?               @relation("PaymentRegistrar", fields: [recordedById], references: [id], onDelete: SetNull)
  voidedBy     User?               @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@unique([gymId, receiptNumber])
  @@index([gymId, paidAt])
  @@index([gymId, status])
  @@index([gymId, memberId])
  @@index([recordedById])
  @@index([subscriptionId])
  @@index([obligationId])
  @@index([cashRegisterId])
}

// ── Attendance: historical check-in records (never hard-deleted) ─────────────

model Attendance {
  id          String           @id @default(uuid())
  gymId       String
  memberId    String
  checkInTime DateTime         @default(now())
  checkOutTime DateTime?
  status      AttendanceStatus @default(PRESENT)
  method      AttendanceMethod @default(MANUAL)
  /// ALLOWED when the access policy passed; EXCEPTION when an administrator
  /// authorized the entry despite a blocking condition.
  result      AttendanceResult @default(ALLOWED)
  exceptionReason String?     @db.VarChar(500)
  /// Snapshot of the membership state at check-in, kept for the history.
  membershipStatusAtCheckIn String? @db.VarChar(20)
  notes       String?
  recordedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  gym        Gym              @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member     MemberProfile    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  recordedBy User?            @relation("AttendanceRegistrar", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([gymId, memberId, checkInTime])
  @@index([gymId, checkInTime])
  @@index([gymId, memberId])
  @@index([gymId, method])
  @@index([gymId, result])
  @@index([memberId])
  @@index([recordedById])
}

// ── Routine: training routines ───────────────────────────────────────────────

model Routine {
  id            String        @id @default(uuid())
  gymId         String
  name          String        @db.VarChar(140)
  description   String?
  difficulty    DifficultyLevel @default(MEDIUM)
  estimatedWeeks Int          @default(4)
  /// Lifecycle: DRAFT (being built), ACTIVE (in force for the member),
  /// ARCHIVED (superseded or retired — always kept as history).
  status        RoutineStatus @default(DRAFT)
  /// Current version number; every accepted change appends a RoutineVersion.
  version       Int           @default(1)
  createdBy     String?
  assignedToId  String?
  /// Instructor responsible for the routine (may differ from its author).
  instructorId  String?
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  /// Kept in sync with `status` so earlier modules keep working unchanged.
  isActive      Boolean       @default(true)
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  gym        Gym                   @relation(fields: [gymId], references: [id], onDelete: Restrict)
  creator    User?                 @relation("RoutineCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignee   MemberProfile?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  instructor InstructorProfile?     @relation("RoutineInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  days        RoutineDay[]
  versions    RoutineVersion[]

  @@index([gymId, isActive])
  @@index([gymId, status])
  @@index([gymId, assignedToId])
  @@index([gymId, assignedToId, status])
  @@index([gymId, instructorId])
  @@index([gymId, deletedAt])
  @@index([createdBy])
}

// ── RoutineVersion: immutable snapshot of a routine at each accepted change ──
// Never edited or deleted by the application: it is how the historical
// configuration of a routine stays queryable after it is modified or archived.

model RoutineVersion {
  id          String        @id @default(uuid())
  gymId       String
  routineId   String
  version     Int
  status      RoutineStatus
  /// CREATE | UPDATE | ACTIVATE | ARCHIVE | SUPERSEDED
  reason      String?       @db.VarChar(40)
  createdById String?
  snapshot    Json
  createdAt   DateTime      @default(now())

  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Restrict)
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("RoutineVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([routineId, version])
  @@index([gymId, routineId])
  @@index([gymId, createdAt])
}

// ── RoutineDay: one training session within a routine ────────────────────────

model RoutineDay {
  id          String   @id @default(uuid())
  gymId       String
  routineId   String
  name        String   @db.VarChar(140)
  dayOrder    Int      @default(0)
  description String?
  restDay     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym        Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  routine    Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises  RoutineExercise[]

  @@unique([routineId, dayOrder])
  @@index([gymId])
  @@index([routineId])
}

// ── Exercise: gym-wide exercise catalog ──────────────────────────────────────

model Exercise {
  id           String        @id @default(uuid())
  gymId        String
  name         String        @db.VarChar(140)
  description  String?
  muscleGroup  MuscleGroup   @default(OTHER)
  exerciseType ExerciseType  @default(STRENGTH)
  equipment    String[]      @default([])
  videoUrl     String?
  imageUrl     String?
  instructions String?
  tips         String?
  isPublic     Boolean       @default(false)
  createdBy    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  gym     Gym               @relation(fields: [gymId], references: [id], onDelete: Restrict)
  creator User?             @relation("ExerciseCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  usages  RoutineExercise[]

  @@unique([gymId, name])
  @@index([gymId, muscleGroup])
  @@index([gymId, isActive])
  @@index([gymId, exerciseType])
  @@index([gymId, isPublic])
}

// ── RoutineExercise: link between RoutineDay and Exercise ────────────────────

model RoutineExercise {
  id           String   @id @default(uuid())
  gymId        String
  routineDayId String
  exerciseId   String
  exerciseOrder Int     @default(0)
  sets         Int      @default(3)
  reps         String   @default("10") @db.VarChar(50)
  restSeconds  Int      @default(60)
  weightKg     Decimal? @db.Decimal(6, 2)
  durationSec  Int?
  /// Optional execution tempo, e.g. "3-1-2".
  tempo        String?  @db.VarChar(20)
  targetRPE    Decimal? @db.Decimal(4, 2)
  instructions String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gym        Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  routineDay RoutineDay  @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([routineDayId, exerciseId, exerciseOrder])
  @@index([gymId])
  @@index([routineDayId])
  @@index([exerciseId])
  @@index([gymId, routineDayId])
}

// ── ProgressRecord: physical evaluations over time ───────────────────────────

model ProgressRecord {
  id          String         @id @default(uuid())
  gymId       String
  memberId    String
  recordedById String?
  metric      ProgressMetric
  value       Decimal        @db.Decimal(8, 2)
  unit        String         @default("kg") @db.VarChar(20)
  bodyFatPct  Decimal?       @db.Decimal(5, 2)
  notes       String?
  measuredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  gym        Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member     MemberProfile @relation(fields: [memberId], references: [id], onDelete: Restrict)
  recordedBy User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([gymId, memberId])
  @@index([gymId, metric])
  @@index([gymId, measuredAt])
  @@index([memberId])
  @@index([recordedById])
}

// ── AuthToken: one-time, single-use credentials setup / password reset ───────
// Only a SHA-256 hash of the token is stored; the raw token is returned exactly
// once at creation and never persisted or logged.

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  tokenHash String        @unique @db.VarChar(128)
  type      AuthTokenType @default(SETUP)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── AuditLog: important operations ────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  gymId      String
  userId     String?
  action     AuditAction
  entityType String      @db.VarChar(80)
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?     @db.VarChar(400)
  createdAt  DateTime    @default(now())

  gym  Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gymId, createdAt])
  @@index([gymId, entityType])
  @@index([gymId, action])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ── Notifications ──────────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  gymId       String
  userId      String
  type        NotificationType
  title       String           @db.VarChar(200)
  message     String
  link        String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  metadata    Json?
  /// Idempotency key: one notification per event and recipient.
  dedupeKey   String?          @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId, userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model Announcement {
  id          String               @id @default(uuid())
  gymId       String
  authorId    String
  title       String               @db.VarChar(200)
  content     String
  status      AnnouncementStatus   @default(DRAFT)
  audience    AnnouncementAudience @default(ALL)
  targetUserId String?
  publishAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([gymId, status])
  @@index([publishAt])
}

model NotificationPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  gymId             String
  inApp             Boolean  @default(true)
  email             Boolean  @default(true)
  membershipAlerts  Boolean  @default(true)
  routineAlerts     Boolean  @default(true)
  paymentAlerts     Boolean  @default(true)
  generalAlerts     Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

model NotificationLog {
  id        String   @id @default(uuid())
  gymId     String
  userId    String?
  type      String
  channel   String   @default("inapp")
  status    String
  error     String?
  metadata  Json?
  createdAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt])
}
