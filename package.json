{
  "name": "gym-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS for gym management",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client & wait",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace server",
    "db:push": "npm run db:push --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:studio": "npm run db:studio --workspace server",
    "start": "npm run start --workspace server"
  },
  "engines": {
    "node": ">=20"
  }
}
